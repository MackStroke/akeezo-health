{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "express",
      "entrypoint": "main.js"
    },
    "case-management": {
      "root": "apps/case-management",
      "framework": "vite",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/case-management/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/case-management/(.*)",
          "destination": "/index.html"
        },
        {
          "source": "/case-management",
          "destination": "/index.html"
        },
        {
          "source": "/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "admin": {
      "root": "apps/admin",
      "framework": "vite",
      "outputDirectory": "dist",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/admin/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/admin/(.*)",
          "destination": "/index.html"
        },
        {
          "source": "/admin",
          "destination": "/index.html"
        },
        {
          "source": "/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "outputDirectory": "dist/client",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/assets/(.*)",
          "destination": "/assets/$1"
        },
        {
          "source": "/logo/(.*)",
          "destination": "/logo/$1"
        },
        {
          "source": "/uploads/(.*)",
          "destination": "/uploads/$1"
        },
        {
          "source": "/v2/(.*)",
          "destination": "/v2/$1"
        },
        {
          "source": "/favicon.ico",
          "destination": "/logo/favicon.svg"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "bindings": [
        {
          "type": "service",
          "service": "server",
          "format": "url",
          "env": "SERVER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/case-management/assets/(.*)",
      "destination": {
        "service": "case-management",
        "path": "/case-management/assets/$1"
      }
    },
    {
      "source": "/case-management/(.*\\.(?:ico|png|jpg|jpeg|webp|svg|css|js|woff2|woff|ttf|json|txt|xml))",
      "destination": {
        "service": "case-management",
        "path": "/$1"
      }
    },
    {
      "source": "/case-management",
      "destination": {
        "service": "case-management"
      }
    },
    {
      "source": "/case-management/(.*)",
      "destination": {
        "service": "case-management"
      }
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": {
        "service": "admin",
        "path": "/admin/assets/$1"
      }
    },
    {
      "source": "/admin/(.*\\.(?:ico|png|jpg|jpeg|webp|svg|css|js|woff2|woff|ttf|json|txt|xml))",
      "destination": {
        "service": "admin",
        "path": "/$1"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/logo/(.*)",
      "destination": {
        "service": "web",
        "path": "/logo/$1"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "web",
        "path": "/uploads/$1"
      }
    },
    {
      "source": "/v2/(.*)",
      "destination": {
        "service": "web",
        "path": "/v2/$1"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "web",
        "path": "/logo/favicon.svg"
      }
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|webp|svg|css|js|woff2|woff|ttf|json|txt|xml))",
      "destination": {
        "service": "web",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
